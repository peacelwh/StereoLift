+def load_episode_groups(manifest_path: str | Path) -> list[list[int]]:
+    """Load contiguous episode groups from a RoboCasa365-style parquet manifest.
+
+    The merged Human300 dataset records each original source task with an inclusive
+    ``output_episode_from`` and exclusive ``output_episode_to`` boundary. Keeping
+    this loader here makes the sampler independent of RoboCasa itself.
+    """
+    import pyarrow.parquet as pq
+
+    path = Path(manifest_path)
+    if not path.is_file():
+        raise FileNotFoundError(f"Task sampling manifest does not exist: {path}")
+    table = pq.read_table(path, columns=["output_episode_from", "output_episode_to"])
+    starts = table["output_episode_from"].to_numpy(zero_copy_only=False)
+    ends = table["output_episode_to"].to_numpy(zero_copy_only=False)
+    if len(starts) == 0:
+        raise ValueError(f"Task sampling manifest contains no rows: {path}")
+
+    groups: list[list[int]] = []
+    previous_end: int | None = None
+    for row, (start_value, end_value) in enumerate(zip(starts, ends, strict=True)):
+        start, end = int(start_value), int(end_value)
+        if start < 0 or end <= start:
+            raise ValueError(f"Invalid episode range in {path} row {row}: [{start}, {end})")
+        if previous_end is not None and start < previous_end:
+            raise ValueError(
+                f"Overlapping or unsorted episode ranges in {path}: row {row} starts at {start}, "
+                f"before the previous end {previous_end}"
+            )
+        groups.append(list(range(start, end)))
+        previous_end = end
+    return groups
+
+
+class TaskBalancedSampler:
+    """Hierarchical sampler for merged multi-task trajectory datasets.
+
+    Every sample independently chooses a task with probability proportional to
+    ``valid_task_frames**task_sampling_power``, then chooses a trajectory uniformly
+    inside that task, and finally a frame uniformly inside that trajectory. This is
+    the sampling protocol used by RoboCasa365's official Human300 OpenPI loader.
+
+    Samples are generated by a stateless counter hash, so the sequence is a pure
+    function of ``(seed, epoch, position)``. All distributed ranks regenerate the
+    same global sequence for Accelerate to shard, while resuming at a saved position
+    does not require replaying earlier samples.
+    """
+
+    _MASK64 = (1 << 64) - 1
+    _STREAM_GROUP = np.uint64(0xA0761D6478BD642F)
+    _STREAM_EPISODE = np.uint64(0xE7037ED1A0B428DB)
+    _STREAM_FRAME = np.uint64(0x8EBC6AF09C88C6E3)
+
+    def __init__(
+        self,
+        dataset_from_indices: Sequence[int],
+        dataset_to_indices: Sequence[int],
+        episode_groups: Sequence[Sequence[int]],
+        episode_indices_to_use: Sequence[int] | None = None,
+        drop_n_first_frames: int = 0,
+        drop_n_last_frames: int = 0,
+        task_sampling_power: float = 0.4,
+        seed: int = 0,
+        group_weights: Sequence[float] | None = None,
+        num_samples: int | None = None,
+        absolute_to_relative_idx: dict[int, int] | None = None,
+    ):
+        if drop_n_first_frames < 0:
+            raise ValueError(f"drop_n_first_frames must be >= 0, got {drop_n_first_frames}")
+        if drop_n_last_frames < 0:
+            raise ValueError(f"drop_n_last_frames must be >= 0, got {drop_n_last_frames}")
+        if task_sampling_power < 0:
+            raise ValueError(f"task_sampling_power must be non-negative, got {task_sampling_power}")
+
+        from_indices = np.asarray(dataset_from_indices, dtype=np.int64)
+        to_indices = np.asarray(dataset_to_indices, dtype=np.int64)
+        if from_indices.shape != to_indices.shape:
+            raise ValueError(
+                "dataset_from_indices and dataset_to_indices must have the same length, "
+                f"got {len(from_indices)} and {len(to_indices)}"
+            )
+        if len(from_indices) == 0:
+            raise ValueError("Cannot construct a TaskBalancedSampler for an empty dataset")
+
+        valid_episodes = (
+            set(range(len(from_indices)))
+            if episode_indices_to_use is None
+            else {int(index) for index in episode_indices_to_use}
+        )
+        if any(index < 0 or index >= len(from_indices) for index in valid_episodes):
+            raise ValueError("episode_indices_to_use contains an out-of-range episode index")
+
+        covered: set[int] = set()
+        group_starts: list[np.ndarray] = []
+        group_lengths: list[np.ndarray] = []
+        group_frame_counts: list[int] = []
+        kept_groups: list[int] = []
+        for group_index, group in enumerate(episode_groups):
+            group_episode_indices = [int(index) for index in group if int(index) in valid_episodes]
+            if len(group_episode_indices) != len(set(group_episode_indices)):
+                raise ValueError(f"Episode group {group_index} contains duplicate episode indices")
+            overlap = covered.intersection(group_episode_indices)
+            if overlap:
+                raise ValueError(
+                    f"Episode groups overlap; group {group_index} repeats episode(s) {sorted(overlap)[:5]}"
+                )
+            covered.update(group_episode_indices)
+
+            starts, lengths = [], []
+            for episode_index in group_episode_indices:
+                if episode_index < 0 or episode_index >= len(from_indices):
+                    raise ValueError(
+                        f"Episode group {group_index} contains out-of-range index {episode_index}"
+                    )
+                start = int(from_indices[episode_index]) + drop_n_first_frames
+                length = int(to_indices[episode_index]) - drop_n_last_frames - start
+                if length <= 0:
+                    logger.warning(
+                        "Episode %d has no valid frames after dropping %d first and %d last frames; skipping.",
+                        episode_index,
+                        drop_n_first_frames,
+                        drop_n_last_frames,
+                    )
+                    continue
+                starts.append(start)
+                lengths.append(length)
+
+            if starts:
+                starts_array = np.asarray(starts, dtype=np.int64)
+                lengths_array = np.asarray(lengths, dtype=np.int64)
+                group_starts.append(starts_array)
+                group_lengths.append(lengths_array)
+                group_frame_counts.append(int(lengths_array.sum()))
+                kept_groups.append(group_index)
+
+        uncovered = valid_episodes - covered
+        if uncovered:
+            raise ValueError(
+                "Task sampling manifest does not cover all selected episodes; first missing episode(s): "
+                f"{sorted(uncovered)[:5]}"
+            )
+        if not group_starts:
+            raise ValueError("No valid task groups remain after episode filtering")
+
+        frame_counts = np.asarray(group_frame_counts, dtype=np.float64)
+        weights = np.power(frame_counts, task_sampling_power)
+        if group_weights is not None:
+            if len(group_weights) != len(episode_groups):
+                raise ValueError(f"group_weights has {len(group_weights)} entries for {len(episode_groups)} groups")
+            weights = weights * np.asarray([float(group_weights[g]) for g in kept_groups], dtype=np.float64)
+            if not np.all(weights >= 0) or weights.sum() <= 0:
+                raise ValueError("group_weights must be non-negative with a positive total")
+        self._task_probabilities = weights / weights.sum()
+        self._task_cdf = np.cumsum(self._task_probabilities)
+        self._task_cdf[-1] = 1.0
+        self._group_starts = group_starts
+        self._group_lengths = group_lengths
+        total_valid_frames = int(sum(group_frame_counts))
+        self._num_samples = total_valid_frames if num_samples is None else int(num_samples)
+        if self._num_samples <= 0:
+            raise ValueError(f"num_samples must be positive, got {self._num_samples}")
+        self.seed = int(seed)
+        self._epoch = 0
+        self._start_index = 0
+        self._absolute_to_relative = absolute_to_relative_idx
+        self._chunk_size = 65_536
+
+    @property
+    def task_probabilities(self) -> np.ndarray:
+        return self._task_probabilities.copy()
+
+    def set_epoch(self, epoch: int) -> None:
+        self._epoch = int(epoch)
+
+    def state_dict(self) -> dict:
+        return {"epoch": self._epoch, "start_index": self._start_index}
+
+    def load_state_dict(self, state: dict) -> None:
+        self._epoch = int(state["epoch"])
+        self._start_index = int(state["start_index"])
+
+    @classmethod
+    def _splitmix64(cls, values: np.ndarray) -> np.ndarray:
+        with np.errstate(over="ignore"):
+            values = values + np.uint64(0x9E3779B97F4A7C15)
+            values = (values ^ (values >> np.uint64(30))) * np.uint64(0xBF58476D1CE4E5B9)
+            values = (values ^ (values >> np.uint64(27))) * np.uint64(0x94D049BB133111EB)
+            return values ^ (values >> np.uint64(31))
+
+    def _sample_chunk(self, positions: np.ndarray, epoch: int) -> np.ndarray:
+        seed_value = np.uint64(self.seed & self._MASK64)
+        epoch_value = np.uint64(epoch & self._MASK64)
+        base = positions.astype(np.uint64, copy=False) ^ seed_value ^ self._splitmix64(
+            np.asarray([epoch_value], dtype=np.uint64)
+        )[0]
+        group_random = self._splitmix64(base ^ self._STREAM_GROUP)
+        episode_random = self._splitmix64(base ^ self._STREAM_EPISODE)
+        frame_random = self._splitmix64(base ^ self._STREAM_FRAME)
+
+        unit = (group_random >> np.uint64(11)).astype(np.float64) * (1.0 / (1 << 53))
+        selected_groups = np.searchsorted(self._task_cdf, unit, side="right")
+        result = np.empty(len(positions), dtype=np.int64)
+        for group_index in np.unique(selected_groups):
+            mask = selected_groups == group_index
+            starts = self._group_starts[int(group_index)]
+            lengths = self._group_lengths[int(group_index)]
+            selected_episodes = (episode_random[mask] % np.uint64(len(starts))).astype(np.int64)
+            selected_lengths = lengths[selected_episodes]
+            offsets = (frame_random[mask] % selected_lengths.astype(np.uint64)).astype(np.int64)
+            result[mask] = starts[selected_episodes] + offsets
+        return result
+
+    def __iter__(self) -> Iterator[int]:
+        epoch, start = self._epoch, self._start_index
+        self._epoch += 1
+        self._start_index = 0
+        return self._iter_epoch(epoch, start)
+
+    def _iter_epoch(self, epoch: int, start: int) -> Iterator[int]:
+        for chunk_start in range(start, self._num_samples, self._chunk_size):
+            chunk_end = min(chunk_start + self._chunk_size, self._num_samples)
+            positions = np.arange(chunk_start, chunk_end, dtype=np.uint64)
+            for absolute_index in self._sample_chunk(positions, epoch):
+                index = int(absolute_index)
+                if self._absolute_to_relative is not None:
+                    index = self._absolute_to_relative[index]
+                yield index
+
+    def __len__(self) -> int:
+        return self._num_samples
+
