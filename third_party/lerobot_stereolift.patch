+def _filter_dataset_image_features(dataset: Any, selected_image_features: list[str]) -> None:
+    if not selected_image_features:
+        return
+
+    selected = set(selected_image_features)
+    available = set(dataset.meta.camera_keys)
+    missing = selected - available
+    if missing:
+        raise ValueError(
+            f"selected_image_features contains keys not present in the dataset: {sorted(missing)}. "
+            f"Available image features are: {sorted(available)}"
+        )
+
+    dropped = sorted(available - selected)
+    if dropped:
+        logging.info(f"Using selected image features: {sorted(selected)}; dropping image features: {dropped}")
